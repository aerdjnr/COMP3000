<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Velocity.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
        x:Class="Velocity.Views.RemView"
        x:DataType="vm:RemViewModel">
    
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
          ColumnDefinitions="10,Auto, Auto, Auto">
        <Button Content="Back"
            FontSize="14"
            Width="75"
            Height="30"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Margin="5,5,40,0"
            Grid.Row="0"
            Grid.Column="0"
            Command="{Binding GoBackCommand}"/>

        <TextBlock 
            Text="Select a Lab"
            FontSize="28"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Grid.Row="1"
            Grid.Column="1"
            Padding="0,0,0,0"/>
        <TextBlock 
            FontSize="16"
            Grid.Row="1"
            Grid.Column="1"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            Padding="0,45,0,0">There will be more labs on the way!</TextBlock>
        
        <Button Content="Information"
            FontSize="16"
            Width="125"
            Height="50"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            HorizontalAlignment="Center"
            Margin="0,50,0,0"
            Grid.Row="2"
            Grid.Column="1"
            Command="{Binding OpenInformationCommand}"/>

        <Button Content="Defense"
            FontSize="16"
            Width="125"
            Height="50"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            HorizontalAlignment="Center"
            Margin="140,50,50,0"
            Grid.Row="2"
            Grid.Column=""
            Command="{Binding OpenDefenseCommand}"/>


        <Button Content="Offense"
            FontSize="16"
            Width="125"
            Height="50"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            HorizontalAlignment="Center"
            Margin="0,50,0,0"
            Grid.Row="2"
            Grid.Column="2"
            Command="{Binding OpenOffenseCommand}"/>

    </Grid>
    
   
</UserControl>
