<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Velocity.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Velocity.Views.TutView"
        x:DataType="vm:TutViewModel">
    
    <Grid RowDefinitions="Auto,Auto,Auto,Auto">

        <Button Content="Velocity"
            FontSize="16"
            Width="125"
            Height="50"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            HorizontalAlignment="Center"
            Margin="200,0,0,0"
            Grid.Row="1"
            Command="{Binding OpenVelocityCommand}"/>
        
        <Button Content="Offense"
            FontSize="16"
            Width="125"
            Height="50"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            HorizontalAlignment="Center"
            Margin="0,0,200,0"
            Grid.Row="0"/>

        <Button Content="Defense"
            FontSize="16"
            Width="125"
            Height="50"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            HorizontalAlignment="Center"
            Margin="0,0,200,0"
            Grid.Row="1"
            Command="{Binding OpenDefenseCommand}"/>

        <Button Content="Information"
            FontSize="16"
            Width="125"
            Height="50"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            HorizontalAlignment="Center"
            Margin="0,0,200,0"
            Grid.Row="0"/>

    </Grid>
    
   
</UserControl>
