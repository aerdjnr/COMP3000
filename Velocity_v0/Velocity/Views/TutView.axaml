<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Velocity.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Velocity.Views.TutView"
        x:DataType="vm:TutViewModel">
    
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
          ColumnDefinitions="Auto,1">
        <Button Content="Back"
            FontSize="14"
            Width="75"
            Height="30"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Margin="5,5,150,0"
            Grid.Row="0"
            Grid.Column="0"
            Command="{Binding GoBackCommand}"/>

        <Button Content="Introduction"
            FontSize="16"
            Width="125"
            Height="50"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            HorizontalAlignment="Center"
            Margin="0,50,200,0"
            Grid.Row="1"
            Grid.Column="1"
            Command="{Binding OpenIntroductionCommand}"/>
        
        <Button Content="Defense"
            FontSize="16"
            Width="125"
            Height="50"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            HorizontalAlignment="Center"
            Margin="200,50,0,0"
            Grid.Row="1"
            Grid.Column="1"
            Command="{Binding OpenDefenseCommand}"/>

        <Button Content="Offense"
            FontSize="16"
            Width="125"
            Height="50"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            HorizontalAlignment="Center"
            Margin="0,50,200,0"
            Grid.Row="2"
            Grid.Column="1"/>


        <Button Content="Information"
            FontSize="16"
            Width="125"
            Height="50"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            HorizontalAlignment="Center"
            Margin="200,50,0,0"
            Grid.Row="2"
            Grid.Column="1"/>

    </Grid>
    
   
</UserControl>
