<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Velocity.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Velocity.Views.DefCLIView"
             x:DataType="vm:DefCLIViewModel">
    <UserControl.Styles>
    
    </UserControl.Styles>
    <SplitView IsPaneOpen="{Binding MenuState}"
                DisplayMode="Overlay"
                OpenPaneLength="350">

        <!--Inside Pane Content-->
        <SplitView.Pane>
            <StackPanel>
                <Button Content="☰"
                        Command="{Binding MenuToggleCommand}"
                        Margin="10,5,0,0"/>
                <Button Content="Back"
                        Margin="10,5,0,0"
                        Command="{Binding GoBackCommand}"/>
                <StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
							
                            <TextBlock
                                Padding="10,20,0,30"
                                Grid.Row="0"
                                TextWrapping="Wrap">
                                Lorem ipsum dolor sit amet, 
                                consectetur adipiscing elit, 
                                sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. 
                                Ut enim ad minim veniam, 
                                quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. 
                                Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. 
                                Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
                            </TextBlock>
     
                            <TextBlock
                                Grid.Row="1"
                                Text="{Binding Q1}"
                                Padding="10,0,10,0"/>
                            <TextBox 
                                Grid.Row="2" 
                                Watermark="Answer"
                                Margin="10,0,10,0"
                                Text="{Binding UserAnswer1, Mode=TwoWay}"
                                IsVisible="{Binding HasInput1}"/>
                            <Button 
                                Grid.Row="3"
                                Margin="10,5,0,20"
                                Command="{Binding Checker1Command}">
                                Check</Button>

                            <TextBlock
                                Grid.Row="4" 
                                Text="{Binding Q2}"
                                Padding="10,0,10,0"/>
                            <TextBox 
                                Grid.Row="5" 
                                Watermark="Answer"
                                Margin="10,0,10,0"
                                Text="{Binding UserAnswer2, Mode=TwoWay}"
                                IsVisible="{Binding HasInput2}"/>
                            <Button 
                                Grid.Row="6"
                                Margin="10,5,0,20"
                                Command="{Binding Checker2Command}">
                                Check</Button>

                            <TextBlock
                                Grid.Row="7" Text="{Binding Q3}"
                                Padding="10,0,10,0"/>
                            <TextBox 
                                Grid.Row="8" 
                                Watermark="Answer"
                                Margin="10,0,10,0"
                                Text="{Binding UserAnswer3, Mode=TwoWay}"
                                IsVisible="{Binding HasInput3}"/>
                            <Button 
                                Grid.Row="9"
                                Margin="10,5,0,20"
                                Command="{Binding Checker3Command}">
                                Check</Button>

                        </Grid>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </SplitView.Pane>

        <!--Menu button and CLI-->
        <SplitView.Content>
            <Grid RowDefinitions="Auto,*">
				<Button Content="☰"
                        Command="{Binding MenuToggleCommand}"
                        Grid.Row="0"
                        VerticalAlignment="Top">
                </Button>

                <DockPanel Grid.Row="1" LastChildFill="True">
                    <TextBox DockPanel.Dock="Top" 
                        BorderThickness="0"
                        Background="Transparent"
                        FocusAdorner="{x:Null}"
                        BorderBrush="Transparent"
                        TextWrapping="Wrap"
                        IsReadOnly="True"
                        Text="Type 'help' to get started with the CLI, for context and questions, click the ☰ button in the top left.">
                    </TextBox>
		
                    <TextBox DockPanel.Dock="Bottom"
                        Text="{Binding CommandInput, UpdateSourceTrigger=PropertyChanged}"
                        FontFamily="Consolas"
                        KeyDown="PressEnter"
                        Watermark="Type here:">
                    </TextBox>
        
                    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OutputLines}"
                                      Padding="10,10,0,0">
                            <ItemsControl.ItemTemplate>
					            <DataTemplate>
					                <TextBlock Text="{Binding}"
                                        FontFamily="Consolas"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
				
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </SplitView.Content>
    </SplitView>

</UserControl>
