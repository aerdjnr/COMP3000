<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Velocity.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Velocity.Views.HomeView"
        x:DataType="vm:HomeViewModel">
    
    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Text="Velocity"
            FontSize="36"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0,20,0,0"
            Grid.Row="0"/>

        <TextBlock Text="Learn with speed and direction"
            FontSize="20"
            HorizontalAlignment="Center"
            Margin="0,0,0,0"
            Grid.Row="1"/>

        <TextBlock Name="WelcomeText"
            TextWrapping="Wrap"
            Width="500"
            FontSize="18"
            HorizontalAlignment="Center"
            Margin="0,50,0,0"
            Grid.Row="2"/>

        <TextBlock Text="Happy Learning!"
            FontSize="18"
            HorizontalAlignment="Center"
            Margin="0,10,0,250"
            Grid.Row="3"/>

        <Button Content="Tutorials"
            FontSize="16"
            Width="125"
            Height="50"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            HorizontalAlignment="Left"
            Margin="200,0,0,0"
            Grid.Row="4"/>
        
        <Button Content="Labs"
            FontSize="16"
            Width="125"
            Height="50"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            HorizontalAlignment="Right"
            Margin="0,0,200,0"
            Grid.Row="4"/>
    </Grid>
    
   
</UserControl>
